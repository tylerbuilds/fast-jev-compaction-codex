{
  "mcpServers": {
    "fast-jev-compaction": {
      "command": "node",
      "args": [
        "./mcp/fast-jev-server.mjs"
      ],
      "cwd": ".",
      "env_vars": [
        "FAST_JEV_PROVIDER",
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_ACCOUNT_ID",
        "FAST_JEV_WRANGLER_COMMAND",
        "TYPESAFE_API_KEY"
      ],
      "startup_timeout_sec": 10,
      "tool_timeout_sec": 120
    }
  }
}
