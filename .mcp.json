{
  "mcpServers": {
    "fast-jev-compaction": {
      "command": "node",
      "args": [
        "./mcp/fast-jev-launcher.mjs"
      ],
      "cwd": ".",
      "env_vars": [
        "FAST_JEV_PROVIDER",
        "TYPESAFE_API_KEY",
        "FAST_JEV_BASE_URL"
      ],
      "startup_timeout_sec": 10,
      "tool_timeout_sec": 120
    }
  }
}
